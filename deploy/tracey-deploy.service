# traceyDB pull-based CD — one-shot poll unit (TEMPLATE).
#
# Do NOT copy this file verbatim: User= and the ExecStart path must match your
# account. On this server cpulidoq's home is /home/cpulidoq@ad.unil.ch (AD
# account), so the path is not the usual /home/<user>. docs/DEPLOY.md shows an
# install snippet that fills both in from `id -un` and $HOME.

[Unit]
Description=Deploy traceyDB when a new deploy/* tag is pushed
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=REPLACE_WITH_id_un
ExecStart=REPLACE_WITH_HOME/tracey-deploy/deploy/poll-deploy.sh
# Optional: email on failure (needs an OnFailure unit — see Module 5).
# OnFailure=tracey-deploy-notify@%n.service
