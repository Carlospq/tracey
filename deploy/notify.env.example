# traceyDB deploy failure notification config.
# Install to /etc/tracey-deploy/notify.env  (root:root, chmod 600 — may hold a
# secret webhook URL). Set one or both channels; leave the other blank.

# Email — requires a working MTA on the server (postfix/sendmail with a relay).
NOTIFY_EMAIL=""

# Incoming webhook URL (Slack / Mattermost / Discord / Teams). Keep it secret.
NOTIFY_WEBHOOK=""
