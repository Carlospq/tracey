library(ape)
library(seqinr)
library(phytools)
library(dplyr)
library(ggtree)
library(tidytree)
library(ggplot2)
########################################
writeClustNexfile<-function(clustfile, P1Tips, P2Tips, C1Tips, C2Tips){
write(file = clustfile, "#NEXUS\nbegin sets;")
write(file = clustfile, paste("\ttaxset a = ", paste(P1Tips, collapse=" "), ";", sep=""), append=TRUE)
write(file = clustfile, paste("\ttaxset b = ", paste(P2Tips, collapse=" "), ";", sep=""), append=TRUE)
write(file = clustfile, paste("\ttaxset c = ", paste(C1Tips, collapse=" "), ";", sep=""), append=TRUE)
write(file = clustfile, paste("\ttaxset d = ", paste(C2Tips, collapse=" "), ";", sep=""), append=TRUE)
write(file = clustfile, "end;", append=TRUE)
}
callLkMap <- function(clustfile, nquartets, rootedTreeFile, model, type, MSAfile){
library(base)
cmd <- paste("iqtree2 -nt AUTO -redo -lmap ", nquartets," -lmclust ", clustfile," -n 0 -s ", MSAfile," -st ", type," -m ", model, " -te ", rootedTreeFile, " >> ../Logs/out_lkmap.log ", sep="")
system(cmd)
}
parseLkMapOutput <- function(MSAfile, nTips){
LkMapFile = paste(MSAfile, ".iqtree", sep="")
alldata <- readLines(LkMapFile)
FirstMilestone <- "Quartet support of regions a1, a2, a3 (mainly for clustered analysis):"
curid <- which(alldata == FirstMilestone)
curid <- curid+3+nTips+2
list2Extract <- strsplit(alldata[curid], " ")[[1]]
list2Extract <- list2Extract[list2Extract !=""]
tempLkmap <- strsplit(list2Extract[3], "\\(")[[1]][2]
tempLkmap <- strsplit(tempLkmap, "\\)")[[1]]
lkmap4Edge = format(as.double(tempLkmap)/100, digits=2, nsmall=2)
return (lkmap4Edge)
}
getChildren <- function(n, e=edges){
c <- e[e[,1] == n, 2]
return(c)
}
getParent <- function(n, e=edges){
c <- e[e[,2] == n, 1]
return(c)
}
getTips <- function(n, t=tips, s=MLsubTrees){
if (n > length(t)) {
clusterTips = s[[n - length(t)]]$tip.label
} else {
clusterTips = t[[n]]
}
return (clusterTips)
}
assign_colors <- function(COLS){
n <- 1
cols_dict <- c()
cols_vect <- c()
for (name in COLS){
if (name %in% labels(cols_dict)){
cols_vect <- c(cols_vect, cols_dict[name])
} else {
cols_vect <- c(cols_vect, n)
cols_dict[name] <- n
n <- n+1
}
}
return(cols_vect)
}
