# Copy to .env and fill in.  .env is gitignored and never deployed — on the
# server it lives at /home/tracey/tracey/.env and is managed by hand.
# settings.py reads this file via django-environ.

# True for local development, False in production.
DEBUG=True

# Public hostname of the deployment (added to ALLOWED_HOSTS / CSRF_TRUSTED_ORIGINS).
# SERVER=tracey.unil.ch

# Asset path prefix used in templates (no trailing slash).
ASSETS_ROOT=/static/assets

# --- Security -------------------------------------------------------------
# Generate one:  python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me

# Production-only hardening (ignored when DEBUG=True). Safe defaults shown.
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_SSL_REDIRECT=False        # set True only once Apache forwards X-Forwarded-Proto
# SECURE_HSTS_SECONDS=0            # raise gradually: 3600 -> 2592000 -> 31536000

# --- Database (MySQL) ----------------------------------------------------
DB_NAME=tracey
DB_USER=tracey
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=3306

# --- External tools (absolute paths on the server) ----------------------
RSCRIPT_PATH=Rscript
FASTAX_PATH=fastax
