# Shell scripts and unit files MUST use LF or they break on the Linux server.
*.sh            text eol=lf
*.service       text eol=lf
*.timer         text eol=lf
deploy/**       text eol=lf
.env.example    text eol=lf

# Deploy/monitoring runbooks and reference configs are read on the Linux server
# and reviewed in PRs — keep them LF so a Windows editor touching them doesn't
# rewrite the whole file as CRLF (rest of the tree is still CRLF, by design).
docs/**         text eol=lf
*.alloy         text eol=lf

# Binary assets — never apply EOL conversion (would corrupt them).
*.pdf           binary
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.woff          binary
*.woff2         binary
*.ttf           binary
*.eot           binary
*.hmm           binary
*.h3f           binary
*.h3i           binary
*.h3m           binary
*.h3p           binary

# Keep these LF so Dependabot diffs stay clean (rest of the tree is still CRLF).
requirements*.txt  text eol=lf

# SQL fixtures load on Linux (CI MySQL) — keep them LF.
*.sql              text eol=lf
